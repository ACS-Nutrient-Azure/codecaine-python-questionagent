# Question Agent 환경변수
# AgentCore Runtime 배포용

# ── AWS 기본 설정 (필수) ─────────────────────────────────────────────────────
AWS_REGION=ap-northeast-2
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# ── Knowledge Base (필수) ────────────────────────────────────────────────────
KB_LOCAL_PATH=/app
KB_TOP_K=3

# ── PostgreSQL (필수 — DB tools 사용) ────────────────────────────────────────
DB_HOST=your-rds.ap-northeast-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=chatbot_db
DB_USER=chatbot_user
DB_PASSWORD=your-db-password

# ── AgentCore Memory (선택) ──────────────────────────────────────────────────
# 채팅 세션 단기 기억 사용 여부 (사용 시 true로 변경)
USE_MEMORY=false
# Memory ID (USE_MEMORY=true인 경우 필수)
MEMORY_ID=

# ── 로컬 테스트용 (배포 시 불필요) ───────────────────────────────────────────
USE_LOCAL_TEST=false
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-4o-mini
DB_API_URL=http://localhost:8006
